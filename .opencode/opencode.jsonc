{
  "$schema": "https://opencode.ai/config.json",
  // Primary session agent. Re-enable the built-in coding agent with:
  //   "agents": { "build": { "disabled": false } }
  // Using `build` bypasses this template's Coordinator workflow.
  "default_agent": "coordinator",
  // Process docs are not ambient. The Coordinator reads them on demand
  // (coordinator.md + skills). Workers must not receive them in the prompt.
  "worktree": {
    "directory": ".worktrees",
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],
  "policies": [
    // Normal Coordinator pushes remain `ask`; common forced forms are hard-denied.
    { "action": "tool.use", "resource": "shell:git push -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push +*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * +*", "effect": "deny" },
  ],
  "agents": {
    "build": {
      "disabled": true,
    },
  },
}
