{
  "$schema": "https://opencode.ai/config.json",
  // Primary session agent. Re-enable the built-in coding agent with:
  //   "agents": { "build": { "disabled": false } }
  // Using `build` bypasses this template's Coordinator workflow.
  "default_agent": "coordinator",
  // Process docs are not ambient. The Coordinator reads them on demand
  // (coordinator.md + skills). Workers must not receive them in the prompt.
  "worktree": {
    "directory": ".worktrees",
  },
  // The Verifier launches the Coordinator through the subagent tool, and the
  // Coordinator then launches a Worker. The default depth of 1 blocks that
  // second level.
  "experimental": {
    "subagent_depth": 2,
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
  ],
  "policies": [
    // Normal Coordinator pushes remain `ask`; common forced forms are hard-denied.
    { "action": "tool.use", "resource": "shell:git push -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push +*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * +*", "effect": "deny" },
  ],
  "agents": {
    "build": {
      "disabled": true,
    },
    "coordinator": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        // ESP-IDF project:
        // { "action": "external_directory", "resource": "/opt/esp/idf/*", "effect": "allow" },
        // { "action": "read", "resource": "/opt/esp/idf/*", "effect": "allow" },
        // { "action": "edit", "resource": "/opt/esp/idf/*", "effect": "deny" },
        // Device access, using the exact command this project runs:
        // { "action": "shell", "resource": "ssh *", "effect": "allow" },
      ],
    },
    // Appended before .opencode/agents/worker.md. The last matching rule wins,
    // so project allows belong after these two defaults. worker.md still
    // appends its git allow and the git deny rules after this list.
    "worker": {
      "permissions": [
        { "action": "skill", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        // ESP-IDF project:
        // { "action": "external_directory", "resource": "/opt/esp/idf/*", "effect": "allow" },
        // { "action": "read", "resource": "/opt/esp/idf/*", "effect": "allow" },
        // { "action": "edit", "resource": "/opt/esp/idf/*", "effect": "deny" },
        // Device access, using the exact command this project runs:
        // { "action": "shell", "resource": "ssh *", "effect": "allow" },
      ],
    },
  },
}
